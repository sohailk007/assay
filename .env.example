# Copy this file to .env and fill in the values.

# SQLite needs nothing installed and is fine for the pilot.
DATABASE_URL=sqlite:///./assay.db

# Switch to Postgres once more than one person uses the dashboard.
# Local Docker:
#   docker run --name tfh-leads -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/assay

# Companies House API key. Free. Register an application at
# https://developer.company-information.service.gov.uk/ and create a REST API key.
COMPANIES_HOUSE_API_KEY=

# Identify yourself politely when fetching company websites.
USER_AGENT=TrainifyHubLeadResearch/1.0 (+https://trainifyhub.co.uk; research contact: compliance@trainifyhub.co.uk)

# Seconds to wait between requests to the same host when scraping company sites.
CRAWL_DELAY_SECONDS=3

# Screening provider: manual | tpsmydata
SCREENING_PROVIDER=manual
TPSMYDATA_API_KEY=
TPSMYDATA_BASE_URL=https://api.tpsmydata.co.uk

# Numbers must be re-screened at least this often before calling.
SCREENING_VALID_DAYS=28

# Evidence older than this stops earning freshness points.
EVIDENCE_FRESH_DAYS=90

# Dashboard sign-off. Every approval is recorded against one of these names.
# Comma separated. No approval is possible for a name not in this list.
AUTHORISED_APPROVERS=
